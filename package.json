{
	"name": "timbre-synth",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "pnpm run build && wrangler dev",
		"deploy": "pnpm run build && wrangler deploy",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"cf:typegen": "wrangler types && mv worker-configuration.d.ts src/"
	},
	"devDependencies": {
		"@eslint/compat": "^1.4.1",
		"@eslint/js": "^9.39.2",
		"@oslojs/crypto": "^1.0.1",
		"@oslojs/encoding": "^1.1.0",
		"@svelte-put/cloudflare-turnstile": "^1.2.0",
		"@sveltejs/adapter-cloudflare": "^7.2.5",
		"@sveltejs/kit": "^2.50.0",
		"@sveltejs/vite-plugin-svelte": "^5.1.1",
		"@tailwindcss/vite": "^4.1.18",
		"@types/audiobuffer-to-wav": "^1.0.4",
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^22.19.7",
		"drizzle-dbml-generator": "^0.10.0",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.14.0",
		"globals": "^16.5.0",
		"prettier": "^3.8.0",
		"prettier-plugin-svelte": "^3.4.1",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"svelte": "^5.47.1",
		"svelte-check": "^4.3.5",
		"svelte-dnd-action": "^0.9.69",
		"tailwindcss": "^4.1.18",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.53.1",
		"vite": "^7.3.1",
		"wrangler": "^4.59.2"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"better-sqlite3"
		],
		"overrides": {
			"esbuild@<=0.24.2": ">=0.25.0",
			"cookie@<0.7.0": ">=0.7.0",
			"devalue@<5.3.2": ">=5.3.2",
			"vite@>=6.0.0 <=6.3.5": ">=6.3.6",
			"vite@>=6.0.0 <=6.4.0": ">=6.4.1",
			"js-yaml@<4.1.1": ">=4.1.1",
			"undici@>=7.0.0 <7.18.2": ">=7.18.2"
		}
	},
	"dependencies": {
		"@cloudflare/vite-plugin": "^1.21.0",
		"@iconify/json": "^2.2.430",
		"@iconify/tailwind4": "^1.2.1",
		"@libsql/client": "^0.15.15",
		"@node-rs/argon2": "^2.0.2",
		"audiobuffer-to-wav": "^1.0.0",
		"better-sqlite3": "^11.10.0",
		"drizzle-kit": "^0.30.6",
		"drizzle-orm": "^0.40.1",
		"ml-pca": "^4.1.1",
		"muuri": "^0.9.5",
		"tone": "^15.1.22"
	}
}
