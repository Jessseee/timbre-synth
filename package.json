{
	"name": "timbre-synth",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "concurrently \"pnpm run paraglide:watch\" \"vite dev\"",
		"paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy cookie globalVariable baseLocale",
		"paraglide:watch": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy cookie globalVariable baseLocale --watch",
		"build": "vite build",
		"preview": "pnpm run build && wrangler pages dev build",
		"deploy": "pnpm run build && wrangler pages deploy build --project-name timbre-synth",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint ."
	},
	"devDependencies": {
		"@eslint/compat": "^1.4.1",
		"@eslint/js": "^9.39.5",
		"@inlang/paraglide-js": "^2.21.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.69.2",
		"@sveltejs/vite-plugin-svelte": "^5.1.1",
		"@tailwindcss/vite": "^4.3.2",
		"@types/audiobuffer-to-wav": "^1.0.4",
		"@types/node": "^22.20.1",
		"concurrently": "^10.0.3",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.20.0",
		"globals": "^16.5.0",
		"prettier": "^3.9.5",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"svelte": "^5.56.4",
		"svelte-check": "^4.7.2",
		"svelte-dnd-action": "^0.9.70",
		"tailwindcss": "^4.3.2",
		"tsx": "^4.23.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.63.0",
		"vite": "^7.3.6",
		"wrangler": "^4.110.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"workerd"
		],
		"overrides": {
			"esbuild@<=0.24.2": ">=0.25.0",
			"cookie@<0.7.0": "0.7.2",
			"devalue@<5.3.2": ">=5.3.2",
			"vite@>=6.0.0 <=6.3.5": ">=6.3.6",
			"vite@>=6.0.0 <=6.4.0": ">=6.4.1",
			"js-yaml@<4.1.1": ">=4.1.1",
			"undici@>=7.0.0 <7.18.2": ">=7.18.2"
		}
	},
	"dependencies": {
		"@iconify/json": "^2.2.499",
		"@iconify/tailwind4": "^1.2.3",
		"audiobuffer-to-wav": "^1.0.0",
		"muuri": "^0.9.5",
		"tone": "^15.1.22"
	}
}
