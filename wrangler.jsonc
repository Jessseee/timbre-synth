{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "xysynth",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"compatibility_date": "2024-09-23",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": {
		"enabled": true
	},
	"r2_buckets": [
		{
			"binding": "R2",
			"bucket_name": "xysynth"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "xysynth",
			"database_id": "a64df17b-6841-43b5-91c8-e6d3c2bf979e",
			"migrations_dir": "./src/lib/server/db/migrations"
		}
	],
	"routes": [
		{
			"pattern": "thesis.jesse-visser.nl",
			"zone_name": "jesse-visser.nl",
			"custom_domain": true
		}
	],
	"workers_dev": false,
	"preview_urls": false
}